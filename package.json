{
  "name": "leximetric",
  "version": "1.0.0",
  "description": "Editorial Read-Time & Linguistic Profiler - Zero-dependency client-side and CLI readability suite",
  "type": "module",
  "main": "./dist-cli/core/index.js",
  "module": "./dist-cli/core/index.js",
  "types": "./dist-cli/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-cli/core/index.d.ts",
      "import": "./dist-cli/core/index.js",
      "default": "./dist-cli/core/index.js"
    }
  },
  "bin": {
    "leximetric": "./dist-cli/cli/index.js"
  },
  "files": [
    "dist-cli",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.cli.json",
    "preview": "vite preview",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:adversarial": "tsx scripts/adversarial_benchmark.ts"
  },
  "keywords": [
    "readability",
    "flesch-kincaid",
    "linguistics",
    "read-time",
    "reading-time",
    "syllables",
    "word-count",
    "gunning-fog",
    "editorial",
    "passive-voice"
  ],
  "author": "LexiMetric Contributors",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
